   "source": [
    "# ── 2.1  Extract ZIP ─────────────────────────────────────────────────────────\n",
    "ZIP_PATH = 'spambase/'   # folder already extracted alongside notebook\n",
    "DATA_FILE = os.path.join(ZIP_PATH, 'spambase.data')\n",
    "NAME_FILE = os.path.join(ZIP_PATH, 'spambase.names')\n",
    "\n",
    "# ── 2.2  Parse column names from .names file ─────────────────────────────────\n",
    def parse_column_names(names_path: str) -> list:
    columns = []
    
    with open(names_path, 'r') as f:
        for line in f:
            line = line.strip()

            # Skip comments and empty lines
            if line.startswith('|') or not line:
                continue

            # Extract feature name from lines like: word_freq_make: continuous.
            if ': continuous.' in line:
                feature_name = line.split(':')[0]
                columns.append(feature_name)

    return columns
    "\n",
   feature_names = parse_column_names(NAME_FILE)
all_columns = feature_names + ['spam']

print(f'Number of features parsed : {len(feature_names)}')
print(f'Total columns (incl. label): {len(all_columns)}')
print('\nFirst 5 feature names:', feature_names[:5])
print('Last  5 feature names:', feature_names[-5:])
   ]
